# Configuração do Servidor de Email (SMTP)
# Preencha com os dados do seu fornecedor de email

# Exemplo para Gmail (Requer Senha de Aplicação):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASS=sua-senha-de-aplicacao
# SMTP_SECURE=false

# Exemplo para Outlook:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=seu-email@outlook.com
# SMTP_PASS=sua-senha
# SMTP_SECURE=false

# Deixe comentado para usar o modo de teste (Ethereal Email) automaticamente.
